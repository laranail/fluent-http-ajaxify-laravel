{
    "name": "laranail/fluent-http-ajaxify-laravel",
    "homepage": "https://opensource.simtabi.com/products/laranail/fluent-http-ajaxify-laravel",
    "support": {
        "issues": "https://github.com/laranail/fluent-http-ajaxify-laravel/issues",
        "source": "https://github.com/laranail/fluent-http-ajaxify-laravel",
        "docs": "https://opensource.simtabi.com/documentation/laranail/fluent-http-ajaxify-laravel/"
    },
    "description": "Laravel integration for FluentHttpAjaxify \u2014 server-driven AJAX responses, CSRF, validation, section redraws, and more.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "ajax",
        "fluent",
        "http",
        "csrf",
        "validation",
        "toast",
        "sections"
    ],
    "authors": [
        {
            "name": "Simtabi LLC",
            "email": "opensource@simtabi.com",
            "homepage": "https://opensource.simtabi.com",
            "role": "Organization"
        },
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.4.1 || ^8.5",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\FluentHttpAjaxify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\FluentHttpAjaxify\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage",
        "pint": "vendor/bin/pint --test",
        "pint-fix": "vendor/bin/pint",
        "lint": [
            "@pint"
        ],
        "format": "@pint-fix",
        "sync-client": "bin/sync-client"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\FluentHttpAjaxify\\Providers\\FluentHttpAjaxifyServiceProvider"
            ],
            "aliases": {
                "Ajaxify": "Simtabi\\Laranail\\FluentHttpAjaxify\\Facade\\Ajaxify"
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
